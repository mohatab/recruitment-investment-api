{
  "name": "recruitment-investment-api",
  "version": "2.0.0",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "recruitment",
    "investment",
    "rest-api",
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "stripe",
    "socket-io",
    "openapi",
    "jest",
    "docker"
  ],
  "author": "",
  "license": "MIT",
  "description": "Node.js/Express REST API for recruitment (jobs, applications, CVs) and startup investment (fundraising rounds, Stripe payments), with JWT auth, role-based authorization, private file storage, email, notifications and Socket.IO messaging.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohatab/recruitment-investment-api.git"
  },
  "bugs": {
    "url": "https://github.com/mohatab/recruitment-investment-api/issues"
  },
  "homepage": "https://github.com/mohatab/recruitment-investment-api#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.687.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.15.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.1",
    "socket.io": "^4.8.1",
    "stripe": "^18.2.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.2",
    "nodemon": "^3.0.3",
    "prettier": "^3.3.3",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
