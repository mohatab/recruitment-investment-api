# Validated at startup (src/config/env.js): the process exits listing every
# missing/invalid variable. [prod] = additionally required when NODE_ENV=production.

# Server
PORT=3000
NODE_ENV=development            # development | production | test
LOG_LEVEL=info                  # error | warn | info | debug
BASE_URL=http://localhost:3000
# [prod] The client app that renders /reset-password and /verify-email (links in emails).
APP_URL=http://localhost:5173
# [prod] Comma-separated allowlist of browser origins; "*" is rejected in production.
CORS_ORIGIN=http://localhost:5173
# Express trust proxy. Leave false unless a reverse proxy you control sets
# X-Forwarded-For (then: 1 = one hop, or "loopback" etc.). Enabling it while
# clients can reach the app directly lets them spoof IPs and bypass rate limits.
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true

# MongoDB
MONGODB_URI=mongodb://localhost:27017/recruitment-investment

# Auth — required; must differ; [prod] 32+ chars. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_value
JWT_REFRESH_SECRET=replace_with_a_different_long_random_value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Stripe [prod]
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Outgoing email (password reset, email verification), via Nodemailer. [prod] SMTP_USER + SMTP_PASS.
# Set SMTP_HOST for a generic SMTP server, OR SMTP_SERVICE for a Nodemailer
# well-known service (e.g. "gmail") — not both.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SERVICE=
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_app_password
# Envelope sender (defaults to SMTP_USER)
EMAIL_FROM="Recruitment & Investment <no-reply@example.com>"

# File storage: "local" (default, no cloud account needed) or "s3" (then S3_BUCKET, S3_REGION and keys are required)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
