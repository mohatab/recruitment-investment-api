# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
BASE_URL=http://localhost:3000
CORS_ORIGIN=*

# MongoDB
MONGODB_URI=mongodb://localhost:27017/recruitment-investment

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_value
JWT_REFRESH_SECRET=replace_with_a_different_long_random_value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Outgoing email (password reset), via Nodemailer.
# Set SMTP_HOST for a generic SMTP server, OR SMTP_SERVICE for a Nodemailer
# well-known service (e.g. "gmail") — not both.
SMTP_HOST=smtp.example.com
SMTP_SERVICE=
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_app_password

# File storage: "local" (default, no cloud account needed) or "s3"
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
