# Dependencies (package-lock.json IS committed: reproducible installs for npm ci / Docker / CI)
node_modules/
yarn.lock

# Environment variables
.env
.env.local
.env.*.local

# Uploaded files (local storage driver) — never commit user-uploaded content
uploads/

# Personal documents never belong in this repo (real CVs/coursework were once
# committed by accident, see docs/PROJECT_AUDIT.md). The app has no committed
# binary assets; add an explicit !exception if that ever changes.
*.pdf
*.doc
*.docx
*.png
*.jpg
*.jpeg
*.webp

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Test/coverage output
coverage/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Windows/Cygwin crash dumps
*.stackdump
